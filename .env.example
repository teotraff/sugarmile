# Copy to .env and fill in
PORT=3000
# Long random string. Sign in to /#admin with it. Generate: openssl rand -hex 24
ADMIN_TOKEN=change-me-to-a-long-random-string
# Domain for Caddy (HTTPS); www. is added automatically
DOMAIN=__DOMAIN__
PUBLIC_URL=https://__DOMAIN__
# Microsoft Clarity project ID (heatmaps). Empty = off
CLARITY_ID=
# Email via Resend (resend.com). Empty key = emails are only printed to the server log
RESEND_API_KEY=
# Sender; the domain must be verified in Resend
MAIL_FROM=Sugarmile <orders@__DOMAIN__>
# Where customer replies go (any mailbox you read)
MAIL_REPLY_TO=support@__DOMAIN__
# DB_PATH=./data/store.db
# STRIPE_SECRET_KEY=sk_live_...
# Meta Pixel (browser) + Conversions API (server). Empty = off
META_PIXEL_ID=
# Events Manager > Settings > Conversions API > Generate access token. Keep it only here, never in git
META_CAPI_TOKEN=
